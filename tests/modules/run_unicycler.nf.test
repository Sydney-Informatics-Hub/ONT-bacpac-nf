nextflow_process {

    name "Test Process unicycler_assembly"
    script "modules/run_unicycler.nf"
    process "unicycler_assembly"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.from([[ "example_sample", null, file("${projectDir}/tests/data/subset2000.fq.gz") ]])
                """
            }
        }

        then {
            assert process.success
            assert file(process.out.unicycler_assembly[0][2]).exists()
            assert file(process.out.unicycler_graph[0][2]).exists()
            def fasta_file = file(process.out.unicycler_assembly[0][2] + '/assembly.fasta')
            assert fasta_file.exists()
        }

    }

}

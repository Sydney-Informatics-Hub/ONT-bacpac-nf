nextflow_process {

    name "Test Process quast_qc_chromosomes"
    script "modules/run_quast_qc_chromosomes.nf"
    process "quast_qc_chromosomes"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.from([[ "example_sample", "flye", file("${projectDir}/tests/data/flye/assembly.fasta") ]])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out.tsv[0]).match()
        }

    }

}

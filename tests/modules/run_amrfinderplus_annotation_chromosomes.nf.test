nextflow_process {

    name "Test Process amrfinderplus_annotation_chromosomes"
    script "modules/run_amrfinderplus_annotation_chromosomes.nf"
    process "amrfinderplus_annotation_chromosomes"

    test("Should run without failures") {

        setup {
            run("get_amrfinderplus") {
                script "modules/get_amrfinderplus.nf"
                process {}
            }
        }

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.from([[ "example_sample", "flye", file("${projectDir}/tests/data/subset2000.bakta.faa") ]])
                input[1] = get_amrfinderplus.out.amrfinderplus_db
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}

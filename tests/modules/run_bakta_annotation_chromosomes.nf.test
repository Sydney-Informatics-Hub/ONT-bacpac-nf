nextflow_process {

    name "Test Process bakta_annotation_chromosomes"
    script "modules/run_bakta_annotation_chromosomes.nf"
    process "bakta_annotation_chromosomes"

    test("Should run without failures") {

        setup {
            run("get_bakta") {
                script "modules/get_bakta.nf"
                process {}
            }
        }

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.from([[ "example_sample", "flye", file("${projectDir}/tests/data/flye/assembly.fasta") ]])
                input[1] = get_bakta.out.bakta_db
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}

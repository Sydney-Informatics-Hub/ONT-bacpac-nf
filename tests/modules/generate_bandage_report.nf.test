nextflow_process {

    name "Test Process generate_bandage_report"
    script "modules/generate_bandage_report.nf"
    process "generate_bandage_report"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.fromPath([ file("${projectDir}/tests/data/example_sample_1.flye.assembly.svg"), file("${projectDir}/tests/data/example_sample_2.flye.assembly.svg") ]).collect()
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}

nextflow_process {

    name "Test Process plassembler"
    script "modules/run_plassembler.nf"
    process "plassembler"

    test("Should run without failures and produce a plasmid assembly") {

        setup {
            run("get_plassembler") {
                script "modules/get_plassembler.nf"
                process {}
            }

            run("flye_assembly") {
                script "modules/run_flye.nf"
                process {
                    """
                    input[0] = channel.from([[ "example_sample", null, file("${projectDir}/tests/data/subset2000.fq.gz") ]])
                    """
                }
            }
        }

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                plassembler_input = channel.from([[ "example_sample", null, file("${projectDir}/tests/data/subset2000.fq.gz") ]])
                    .join(flye_assembly.out.flye_assembly, by: [0, 1])
                    .map { barcode, subset, fq, fa -> [ barcode, subset, fq, fa, 400000 ] }
                input[0] = plassembler_input
                input[1] = get_plassembler.out.plassembler_db
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}

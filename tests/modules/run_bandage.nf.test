nextflow_process {

    name "Test Process bandage"
    script "modules/run_bandage.nf"
    process "bandage"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.from([[ "example_sample", "flye", file("${projectDir}/tests/data/subset2000.flye_assembly.gfa") ]])
                """
            }
        }

        then {
            assert process.success
            assert file(process.out.bandage_plot[0][2]).exists()
        }

    }

}

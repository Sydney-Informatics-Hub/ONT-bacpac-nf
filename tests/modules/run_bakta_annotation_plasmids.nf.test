nextflow_process {

    name "Test Process bakta_annotation_plasmids"
    script "modules/run_bakta_annotation_plasmids.nf"
    process "bakta_annotation_plasmids"

    test("Should run without failures") {

        setup {
            run("get_bakta") {
                script "modules/get_bakta.nf"
                process {}
            }
        }

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.of([ "example_sample", file("${projectDir}/tests/data/plassembler/plassembler_plasmids.fasta") ])
                input[1] = get_bakta.out.bakta_db
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}

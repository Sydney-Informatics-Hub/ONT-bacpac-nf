nextflow_workflow {

    name "Test Workflow denovo"
    script "subworkflows/denovo.nf"
    workflow "denovo"

    test("Should run without failures") {

        setup {
            run("get_plassembler") {
                script "modules/get_plassembler.nf"
                process {}
            }
        }

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            workflow {
                """
                input[0] = channel.from([[ "example_sample", null, file("${projectDir}/tests/data/subset2000.fq.gz") ]])
                input[1] = get_plassembler.out.plassembler_db
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
